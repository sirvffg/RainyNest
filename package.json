{
  "name": "rainynest",
  "version": "1.0.0",
  "private": true,
  "description": "RainyNest 博客系统 — Next.js 15 + Prisma + SQLite，插件/主题可扩展",
  "scripts": {
    "predev": "node scripts/ensure-extensions.js && node scripts/generate-theme-registry.js",
    "dev": "next dev",
    "prebuild": "node scripts/ensure-extensions.js && node scripts/generate-theme-registry.js",
    "build": "next build --turbopack",
    "prestart": "node scripts/ensure-extensions.js && node scripts/generate-theme-registry.js",
    "start": "next start",
    "theme:registry": "node scripts/generate-theme-registry.js",
    "lint": "next lint",
    "prisma:generate": "prisma generate --schema=prisma/schema.prisma && prisma generate --schema=prisma-analytics/analytics.prisma",
    "db:migrate": "prisma migrate dev --schema=prisma/schema.prisma",
    "db:migrate:analytics": "prisma migrate dev --schema=prisma-analytics/analytics.prisma",
    "db:deploy": "prisma migrate deploy --schema=prisma/schema.prisma && prisma migrate deploy --schema=prisma-analytics/analytics.prisma",
    "db:init": "node scripts/init-analytics-db.js && node scripts/init-fts.js",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio --schema=prisma/schema.prisma",
    "db:studio:analytics": "prisma studio --schema=prisma-analytics/analytics.prisma",
    "setup": "npm run prisma:generate && npm run db:deploy && npm run db:init && npm run db:seed"
  },
  "dependencies": {
    "@expressive-code/plugin-collapsible-sections": "^0.41.0",
    "@expressive-code/plugin-line-numbers": "^0.41.0",
    "@milkdown/kit": "^7.23.0",
    "@prisma/client": "^5.22.0",
    "adm-zip": "^0.6.1",
    "bcryptjs": "^3.0.2",
    "better-sqlite3": "^12.2.0",
    "katex": "^0.16.22",
    "ldapjs": "^3.0.7",
    "lucide-react": "^0.545.0",
    "next": "^15.5.4",
    "next-auth": "5.0.0-beta.29",
    "node-cron": "^3.0.3",
    "nodemailer": "^6.10.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-callouts": "^2.2.0",
    "rehype-expressive-code": "^0.41.0",
    "rehype-external-links": "^3.0.0",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-directive": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "remark-sectionize": "^2.1.0",
    "remark-wiki-link": "^2.0.1",
    "unified": "^11.0.5",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@rainynest/plugin-types": "^0.3.4",
    "@types/adm-zip": "^0.5.8",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.15.0",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^6.4.17",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "postcss": "^8.5.6",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0"
  }
}
